# Rust
/target/
**/*.rs.bk
# Cargo.lock IS committed: this project guarantees bit-exact reproducibility, so
# transitive dependency bumps must be deliberate, reviewed events (re-running the
# RNG golden-vector test), not silent CI drift.

# cbindgen / generated C headers (regenerated by build)
/include/*.h

# Release output (versioned header copied by `make dist`)
/dist/

# Python (oracle generator)
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
